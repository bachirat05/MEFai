    {
      "parameters": {
        "jsCode": "const demande = $json.body;\n\nconst requiredFields = [\n  \"employe_id\",\n  \"date_debut\",\n  \"date_fin\",\n  \"type_conge\",\n  \"motif\",\n];\n\nconst missing = requiredFields.filter(\n  (field) =>\n    demande[field] === undefined ||\n    demande[field] === null ||\n    String(demande[field]).trim() === \"\"\n);\n\nif (missing.length > 0) {\n  return [\n    {\n      json: {\n        statut: \"rejetee\",\n        message: \"La demande est incomplète.\",\n        champs_manquants: missing,\n      },\n    },\n  ];\n}\n\nconst start = new Date(demande.date_debut);\nconst end = new Date(demande.date_fin);\n\nif (Number.isNaN(start.getTime()) || Number.isNaN(end.getTime())) {\n  return [\n    {\n      json: {\n        statut: \"rejetee\",\n        message: \"Les dates fournies sont invalides.\",\n      },\n    },\n  ];\n}\n\nif (end < start) {\n  return [\n    {\n      json: {\n        statut: \"rejetee\",\n        message: \"La date de fin doit être postérieure ou égale à la date de début.\",\n      },\n    },\n  ];\n}\n\nreturn [\n  {\n    json: {\n      ...demande,\n      statut: \"en_attente\",\n      demande_id: `REQ-${Date.now()}`,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
