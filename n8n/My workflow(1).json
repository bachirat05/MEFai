    {
      "parameters": {
        "jsCode": "const html = $input.first().json.data;\n\nconst baseUrl = 'https://www.sgg.gov.ma/';\n\nconst pdfLinks = [];\nconst regex = /href=[\"']([^\"']+\\.pdf(?:\\?[^\"']*)?)[\"']/gi;\n\nlet match;\n\nwhile ((match = regex.exec(html)) !== null) {\n  let url = match[1];\n\n  // Transformer les liens relatifs en URL absolue\n  if (url.startsWith('/')) {\n    url = baseUrl + url;\n  } else if (!url.startsWith('http')) {\n    url = baseUrl + '/' + url;\n  }\n\n  // Éviter les doublons\n  if (!pdfLinks.includes(url)) {\n    pdfLinks.push(url);\n  }\n}\n\nreturn pdfLinks.map(url => ({\n  json: {\n    url: url,\n    source: 'sgg.gov.ma'\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
